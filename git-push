#!/bin/bash
set -euo pipefail

trap 'echo "❌ 发布失败，流程已停止。请查看上方错误。" >&2' ERR

# 从任意目录启动时，都先切换到脚本所在的仓库。
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 在耗时构建前检查 Git 目录写权限，避免沙箱拒绝提交后重复构建。
# 使用独立临时文件，不占用 index.lock，也不修改暂存区。
GIT_WRITE_CHECK=$(mktemp "$(git rev-parse --git-path codex-push-check).XXXXXX") || {
  echo "❌ Git 目录不可写，请取得仓库写入权限后重试；尚未开始构建。" >&2
  exit 1
}
rm -- "$GIT_WRITE_CHECK"

# 生成静态网站（包含草稿）
hugo -D

# 添加所有更改到暂存区
git add .

# 获取当前日期（自动生成）
COMMIT_DATE=$(date +"%Y-%m-%d")

# 提交到本地仓库
if git diff --cached --quiet; then
  echo "没有新的文件改动，继续推送已有提交。"
else
  git commit -m "$COMMIT_DATE"
fi

# 推送到 GitHub
git push origin main

echo "✅ 网站已生成并推送到 GitHub；上线状态请以 GitHub Pages 为准。"
